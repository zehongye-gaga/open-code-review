[Unit]
Description=OpenCodeReview SQLite dashboard backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ocr-review
Group=ocr-review
WorkingDirectory=/opt/open-code-review/service
ExecStart=/usr/bin/node /opt/open-code-review/service/services/github-review/monitor-sqlite-backup.js /etc/ocr-review/monitor.json
TimeoutStopSec=10
MemoryMax=384M
CPUQuota=25%
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
StateDirectory=ocr-monitor
ReadWritePaths=/var/lib/ocr-monitor
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

