{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "reviewhub-audit-repository/v1"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
            },
            "visibility": {
              "type": "string",
              "enum": [
                "public",
                "private"
              ]
            },
            "defaultBranch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "id",
            "name",
            "visibility",
            "defaultBranch",
            "observedAt"
          ],
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "baseBranches": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          },
          "required": [
            "enabled",
            "baseBranches"
          ],
          "additionalProperties": false
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "repository",
        "policy",
        "revision"
      ],
      "additionalProperties": false
    },
    "enabled": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "configuration",
    "enabled"
  ],
  "additionalProperties": false
}
